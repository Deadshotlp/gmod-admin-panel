# Diese Datei ins Repo. Die echte .env NICHT - sie steht in .gitignore.
# Alle Werte selbst eintragen, sie gehören nicht in die Versionsverwaltung.

# --- Betrieb ---------------------------------------------------------------
NODE_ENV=development
PORT=3001

# --- Gamemode-Datenbank ----------------------------------------------------
# Die Datenbank, die der laufende GMod-Server benutzt (dieselbe, die in
# gamemode/modules/_1base/sv_mysql.lua konfiguriert ist). Liegt sie im LAN, muss
# das Panel im selben Netz laufen oder über einen Tunnel angebunden werden.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=5

# --- Steam-Login -----------------------------------------------------------
# API-Key von https://steamcommunity.com/dev/apikey (für Namen und Avatare)
STEAM_API_KEY=
# Zufälliger langer String, signiert das Session-Cookie. Beispiel zum Erzeugen:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Öffentliche Adresse des Panels, für den Steam-Rücksprung
PANEL_URL=http://localhost:3001

# --- Erstzugang ------------------------------------------------------------
# Komma-getrennte SteamID64. Diese Accounts sind immer Admin, auch wenn die
# Tabelle pd_panel_users noch leer ist. Danach über die Oberfläche pflegen.
PANEL_BOOTSTRAP_STEAM_IDS=

# --- Pterodactyl -----------------------------------------------------------
# Client-API-Key (Account-Einstellungen -> API Credentials), NICHT der
# Application-Key. Bleibt serverseitig, geht nie an den Browser.
PTERODACTYL_URL=https://panel.example.com
PTERODACTYL_API_KEY=
# Kurze Server-ID aus der Panel-URL, z.B. "a1b2c3d4"
PTERODACTYL_SERVER_ID=

# Muss zum ConVar pd_server_key auf dem GMod-Server passen
SERVER_KEY=main
